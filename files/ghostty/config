# vim:foldmethod=marker

#: Behavior {{{
clipboard-read                  = allow
clipboard-write                 = allow
command                         = "/bin/zsh --login"
confirm-close-surface           = false
shell-integration               = zsh
shell-integration-features      = cursor,sudo,title,path
notify-on-command-finish        = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after  = 30s
#: }}}

#: Look + feel {{{
background-blur           = true
background-opacity        = 1
font-family               = JetBrainsMono Nerd Font Mono
font-size                 = 14
macos-icon                = retro
macos-titlebar-proxy-icon = visible
macos-titlebar-style      = tabs
macos-window-buttons      = hidden
macos-window-shadow       = false
split-divider-color       = #f5e0dc
theme                     = Catppuccin Mocha
unfocused-split-fill      = #1e1e2e
unfocused-split-opacity   = 0.85
window-padding-x          = 5
window-padding-y          = 10
window-theme              = system
#: }}}

#: Keybinds {{{
# always read opt key as alt
macos-option-as-alt = true

# tabs
keybind = ctrl+space>c=new_tab
keybind = ctrl+space>n=next_tab
keybind = ctrl+space>p=previous_tab
keybind = ctrl+space>1=goto_tab:1
keybind = ctrl+space>2=goto_tab:2
keybind = ctrl+space>3=goto_tab:3
keybind = ctrl+space>4=goto_tab:4
keybind = ctrl+space>5=goto_tab:5
keybind = ctrl+space>6=goto_tab:6
keybind = ctrl+space>7=goto_tab:7
keybind = ctrl+space>8=goto_tab:8
keybind = ctrl+space>9=goto_tab:9
keybind = ctrl+space>shift+4=prompt_tab_title

# windows
keybind = super+n=new_window
keybind = ctrl+space>s=goto_window:next

# splits
keybind = ctrl+space>\=new_split:right
keybind = ctrl+space>shift+\=new_split:right
keybind = ctrl+space>shift+-=new_split:down
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:down
keybind = ctrl+space>k=goto_split:up
keybind = ctrl+space>l=goto_split:right
keybind = ctrl+space>==equalize_splits
keybind = ctrl+space>z=toggle_split_zoom

# searching
keybind = ctrl+space>/=start_search
keybind = performable:n=navigate_search:next
keybind = performable:shift+n=navigate_search:previous
keybind = performable:q=end_search

# navigation
keybind = ctrl+space>d=jump_to_prompt:1
keybind = ctrl+space>u=jump_to_prompt:-1

# copy+paste
keybind = performable:y=copy_to_clipboard

# cmd+. -> reset font size
keybind = all:super+.=reset_font_size
keybind = all:super++=increase_font_size:1
keybind = all:super+-=decrease_font_size:1

# cmd+` -> quick terminal
keybind = global:super+`=toggle_quick_terminal

# shift+enter -> newline (from claude)
keybind = shift+enter=text:\x1b\r

# reload config
keybind = all:super+r=reload_config
#: }}}
