#!/bin/zsh

# Usage: start-dev [directory]
# Sets up a 3-pane dev layout (tmux or native Ghostty splits):
#   Left: nvim | Top-right: claude --ide | Bottom-right: terminal

main() {
    # Resolve target directory to absolute path
    local dir="${1:-$(pwd)}"
    dir="$(cd "$dir" 2>/dev/null && pwd)" || {
        echo "start-dev: directory not found: $1"
        return 1
    }

    if [[ -n "$TMUX" ]]; then
        create_tmux_layout "$dir"
    elif [[ "$TERM_PROGRAM" == "ghostty" ]]; then
        create_ghostty_layout "$dir"
    else
        echo "start-dev: must be run inside tmux or Ghostty"
        return 1
    fi
}

create_ghostty_layout() {
    local dir="$1"
    local work_dir="${HOME}/work"

    osascript - "$dir" "$work_dir" <<'APPLESCRIPT'
on run argv
    set dir to item 1 of argv
    set workDir to item 2 of argv

    tell application "Ghostty"
        -- Grab the terminal where the script is running
        set origTerm to focused terminal of selected tab of front window

        -- Surface configs set working directory for new splits
        set cfgWork to new surface configuration from {initial working directory: workDir}
        set cfgDir to new surface configuration from {initial working directory: dir}

        -- Split right → top-right pane (claude --ide), starting in ~/work
        set rightTerm to split origTerm direction right with configuration cfgWork

        -- Split the right pane down → bottom-right pane (terminal), in target dir
        split rightTerm direction down with configuration cfgDir

        -- Send commands (executes after this script exits)
        input text "cd " & quoted form of dir & linefeed & "nvim" & linefeed to origTerm
        input text "claude --ide" & linefeed to rightTerm

        -- Focus the nvim pane
        focus origTerm
    end tell
end run
APPLESCRIPT
}

create_tmux_layout() {
    local dir="$1"
    local work_dir="${HOME}/work"

    local width="$(tmux display-message -p '#{window_width}')"

    # Vertical split: right pane is 1/3 on wide screens, 1/2 otherwise
    if [[ "$width" -gt 300 ]]; then
        tmux split-window -h -c "$work_dir" -l '33%'
    else
        tmux split-window -h -c "$work_dir"
    fi

    # Horizontal split on the right pane: bottom gets 1/3 height, in target dir
    tmux split-window -v -c "$dir" -l '33%'

    # Capture pane IDs (order: left, top-right, bottom-right)
    local panes=(${(f)"$(tmux list-panes -F '#{pane_id}')"})

    # Send commands to each pane
    tmux send-keys -t "${panes[1]}" "cd ${(q)dir} && nvim" Enter
    tmux send-keys -t "${panes[2]}" "claude --ide" Enter
    tmux send-keys -t "${panes[3]}" "cd ${(q)dir}" Enter

    # Focus the left pane (nvim)
    tmux select-pane -t "${panes[1]}"
}

main "$@"
